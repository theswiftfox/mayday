{
  "$schema": "https://raw.githubusercontent.com/nicx-next/tauri/refs/heads/dev/crates/tauri-utils/schema.json",
  "productName": "My Day",
  "version": "0.1.0",
  "identifier": "com.myday.app",
  "build": {
    "frontendDist": "../../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @myday/web dev",
    "beforeBuildCommand": "pnpm --filter @myday/web build"
  },
  "app": {
    "windows": [
      {
        "title": "My Day",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["myday-server"]
  }
}
