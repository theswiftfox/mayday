  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "shell:allow-open",
    "updater:default",
    "process:default"
  ]
}
